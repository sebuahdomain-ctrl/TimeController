<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupCard"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:elevation="16dp">

    <!-- 1. Header: Judul "Pengaturan" + Tombol Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pengaturan"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClosePopup"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="5dp"
            android:contentDescription="Tutup" />
    </LinearLayout>

    <!-- 2. Tab Timer / Stopwatch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_container"
        android:padding="4dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tabTimerBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Timer"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_tab_active" />

        <TextView
            android:id="@+id/tabStopwatchBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Stopwatch"
            android:textColor="@color/text_gray"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3. VIEWPORT KONTEN: tinggi tetap, tiap sub-view saling menimpa (tidak mengubah ukuran popup) -->
    <FrameLayout
        android:id="@+id/contentViewport"
        android:layout_width="match_parent"
        android:layout_height="162dp">

        <!-- ================= A. VIEW TIMER UTAMA ================= -->
        <LinearLayout
            android:id="@+id/timerMainView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Durasi"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/btnOpenPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preset"
                        android:textColor="@color/maroon_light"
                        android:textStyle="bold"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="1dp"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_box">
                    <NumberPicker
                        android:id="@+id/pickerMinute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/WheelPickerTheme" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text=":"
                    android:textColor="@color/text_gray"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_box">
                    <NumberPicker
                        android:id="@+id/pickerSecond"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/WheelPickerTheme" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/primaryTimerBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_btn_maroon"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/primaryTimerIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/primaryTimerText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MULAI"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resetTimerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="76dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_btn_dark">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_reset" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESET"
                        android:textColor="@color/text_gray"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= B. VIEW PRESET ================= -->
        <LinearLayout
            android:id="@+id/timerPresetView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnBackFromPreset"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|start"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_back" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kembali"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnToggleDeletePreset"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/bg_toggle_delete">

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_trash" />

                    <TextView
                        android:id="@+id/deletePresetBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hapus"
                        android:textColor="@color/text_gray"
                        android:textStyle="bold"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <GridLayout
                android:id="@+id/presetGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:columnCount="4"
                android:rowCount="2" />
        </LinearLayout>

        <!-- ================= C. VIEW TAMBAH PRESET ================= -->
        <LinearLayout
            android:id="@+id/timerAddPresetView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tambah Preset Baru"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/newPresetTimeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_box">
                    <NumberPicker
                        android:id="@+id/pickerNewPresetMinute"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/WheelPickerTheme" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text=":"
                    android:textColor="@color/text_gray"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_box">
                    <NumberPicker
                        android:id="@+id/pickerNewPresetSecond"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:theme="@style/WheelPickerTheme" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCancelAddPreset"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_btn_dark"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_close" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATAL"
                        android:textColor="@color/text_gray"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSaveNewPreset"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_btn_maroon">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIMPAN"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= D. VIEW STOPWATCH ================= -->
        <LinearLayout
            android:id="@+id/stopwatchSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/swFastForwardTap"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Penghitung Waktu"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/lapCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Lap"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_box"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/swMinutes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_box"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:id="@+id/swSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_box">
                    <TextView
                        android:id="@+id/swMillis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/swStartBtn"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_btn_maroon"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:id="@+id/swStartIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/swStartText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MULAI"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <TextView
                    android:id="@+id/swLapBtn"
                    android:layout_width="70dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="PUTARAN"
                    android:textColor="@color/text_gray"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:letterSpacing="0.03"
                    android:background="@drawable/bg_btn_dark"
                    android:alpha="0.4"
                    android:layout_marginEnd="6dp" />

                <FrameLayout
                    android:id="@+id/swResetBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_dark">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_reset" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
