<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="20dp"
    android:elevation="16dp">

    <!-- Header: Judul + Tombol Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pengaturan"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnClosePopup"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Tutup" />
    </LinearLayout>

    <!-- Tab Timer / Stopwatch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_container"
        android:padding="4dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/tabTimerBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="10dp"
            android:gravity="center"
            android:text="Timer"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_tab_active" />

        <TextView
            android:id="@+id/tabStopwatchBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="10dp"
            android:gravity="center"
            android:text="Stopwatch"
            android:textColor="@color/text_gray"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ SECTION TIMER ============ -->
    <LinearLayout
        android:id="@+id/timerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SUB VIEW: Main timer -->
        <LinearLayout
            android:id="@+id/timerMainView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Durasi"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnOpenPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset ›"
                    android:textColor="@color/maroon_light"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/boxMinute"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_box">
                    <TextView
                        android:id="@+id/minuteDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05"
                        android:textColor="@color/text_white"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/text_gray_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="10dp" />

                <LinearLayout
                    android:id="@+id/boxSecond"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_box">
                    <TextView
                        android:id="@+id/secondDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00"
                        android:textColor="@color/text_white"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/primaryTimerBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="MULAI"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:background="@drawable/bg_btn_maroon"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/resetTimerBtn"
                    android:layout_width="90dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="RESET"
                    android:textColor="@color/text_gray"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_dark" />
            </LinearLayout>
        </LinearLayout>

        <!-- SUB VIEW: Preset -->
        <LinearLayout
            android:id="@+id/timerPresetView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnBackFromPreset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="‹ Kembali"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih Preset"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/presetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ SECTION STOPWATCH ============ -->
    <LinearLayout
        android:id="@+id/stopwatchSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Penghitung Waktu"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lapCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Lap"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_box"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/swMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/text_white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_box"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/swSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/text_white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_box">
                <TextView
                    android:id="@+id/swMillis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00"
                    android:textColor="@color/text_white"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/swStartBtn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MULAI"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="@drawable/bg_btn_maroon"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/swLapBtn"
                android:layout_width="100dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="PUTARAN"
                android:textColor="@color/text_gray"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/bg_btn_dark"
                android:alpha="0.4"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/swResetBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="↺"
                android:textColor="@color/text_gray"
                android:textStyle="bold"
                android:textSize="18sp"
                android:background="@drawable/bg_btn_dark" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
