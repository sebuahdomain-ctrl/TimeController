<?xml version="1.0" encoding="utf-8"?>
<!-- Kotak waktu (Interval 1 / Interval 2): sama seperti bg_popup_chip,
     tapi saat isSelected = true latarnya terisi dan garisnya lebih tegas. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33888888">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/popup_selected_bg" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/popup_text_secondary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/popup_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
