<resources>
    <color name="ic_launcher_background">#7B1E1E</color>

    <!-- Warna teks & ikon di notifikasi custom. Dipisah lewat values-night
         karena ?android:attr/textColorPrimary tidak konsisten ikut dark mode
         di beberapa skin OEM (mis. ColorOS) saat dipakai di RemoteViews. -->
    <color name="notif_content_color">#DE000000</color>

    <!-- Warna popup "Atur durasi" (mode terang). Dipisah lewat values-night
         karena popup di-inflate dari context Service, jadi tidak bisa
         mengikuti tema app/DayNight seperti Activity biasa. -->
    <color name="popup_bg">#FBFBFD</color>
    <color name="popup_text">#1C1C1E</color>
    <color name="popup_text_secondary">#6B6B70</color>
    <color name="popup_text_muted">#8E8E93</color>
    <color name="popup_stroke">#D8D8DD</color>
    <color name="popup_selected_bg">#EEEEF1</color>
    <!-- Layar alarm penuh (AlarmActivity). Selalu gelap, tidak ikut mode terang/gelap
         sistem: layar ini muncul saat HP terkunci / layar mati, sering di ruang gelap. -->
    <color name="alarm_bg">#0E0E10</color>
    <color name="alarm_red">#E5484D</color>
    <color name="alarm_red_bg">#2A1213</color>
    <color name="alarm_text">#FFFFFF</color>
    <color name="alarm_text_muted">#8E8E93</color>
    <color name="alarm_track">#1C1C1F</color>
    <color name="alarm_track_stroke">#3A3A3F</color>
</resources>
