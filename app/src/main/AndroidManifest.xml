<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin untuk menampilkan notifikasi (wajib eksplisit mulai Android 13 / API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Izin agar foreground service tetap hidup dan notifikasinya persisten -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Wake lock singkat saat alarm sistem berbunyi (TimerAlarmReceiver) dan
         wake lock cadangan kalau alarm exact tidak boleh dipasang -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Alarm exact (AlarmManager) supaya timer panjang berbunyi tepat waktu
         tanpa menahan CPU tetap bangun. SCHEDULE_EXACT_ALARM dipakai di
         Android 12 (API 31-32); mulai Android 13 pakai USE_EXACT_ALARM
         (izin otomatis untuk app timer/alarm). Di bawah Android 12 tidak perlu izin. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Izin untuk menampilkan popup di atas aplikasi lain -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Timer App"
        android:theme="@style/Theme.TimerApp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity perantara (transparan, langsung finish) supaya notification
             shade menutup saat tombol "Atur" di-tap -->
        <activity
            android:name=".PopupTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.TimerApp.Trampoline"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Activity perantara untuk tombol Play/Pause (transparan, langsung finish)
             supaya notification shade menutup saat Play di-tap -->
        <activity
            android:name=".PlayTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.TimerApp.Trampoline"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Foreground service pemegang notifikasi persisten -->
        <service
            android:name=".TimerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Service yang menangani jendela overlay (popup) -->
        <service
            android:name=".OverlayPopupService"
            android:exported="false" />

        <!-- Menerima aksi tombol Reset dan Matikan alarm dari notifikasi
             (Play/Pause sebagai cadangan) tanpa membuka Activity -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Menerima alarm sistem (AlarmManager) saat hitung mundur habis,
             lalu meneruskannya ke TimerForegroundService -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false" />

    </application>
</manifest>
